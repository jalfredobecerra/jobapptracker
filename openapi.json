{
  "openapi": "3.0.3",
  "info": {
    "title": "Job Application Tracker API",
    "version": "2.0.0",
    "description": "Job applications and interviews belonging to the signed-in GitHub user. First GitHub sign-in creates a user account. GitHub OAuth uses PKCE, and sessions use a signed HttpOnly cookie. Logout invalidates prior sessions. Open /auth/github in this browser, then return to Swagger UI to test protected routes. Existing Week 03 documents without an owner are not shown to signed-in users."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "GitHub OAuth login, current user, and logout"
    },
    {
      "name": "Applications",
      "description": "Job applications"
    },
    {
      "name": "Interviews",
      "description": "Interviews linked to applications"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "API is running",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/applications": {
      "get": {
        "tags": [
          "Applications"
        ],
        "summary": "List applications",
        "description": "Returns applications newest first. No query parameters are accepted. Only the signed-in user’s records are visible and editable.",
        "responses": {
          "200": {
            "description": "Applications",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Application"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "post": {
        "tags": [
          "Applications"
        ],
        "summary": "Create an application",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplicationInput"
              },
              "example": {
                "company": "Northstar Labs",
                "position": "Software Developer",
                "location": "Bogotá, Colombia",
                "workMode": "hybrid",
                "employmentType": "full-time",
                "status": "applied",
                "appliedAt": "2026-09-28T14:00:00Z",
                "source": "Company website",
                "jobUrl": "https://example.com/jobs/123",
                "salaryMin": 40000,
                "salaryMax": 60000,
                "currency": "USD",
                "notes": "Referral from a colleague"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created; Location header points to the resource",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Application"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "description": "Only the signed-in user’s records are visible and editable."
      }
    },
    "/api/applications/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/Id"
        }
      ],
      "get": {
        "tags": [
          "Applications"
        ],
        "summary": "Get one application",
        "responses": {
          "200": {
            "description": "Application",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Application"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "description": "Only the signed-in user’s records are visible and editable."
      },
      "put": {
        "tags": [
          "Applications"
        ],
        "summary": "Replace an application",
        "description": "Send all required fields. Omitted optional fields are removed. Only the signed-in user’s records are visible and editable.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplicationInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated application",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Application"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "delete": {
        "tags": [
          "Applications"
        ],
        "summary": "Delete an application",
        "description": "Delete its interviews first; otherwise the API returns 409. Only the signed-in user’s records are visible and editable.",
        "responses": {
          "204": {
            "description": "Deleted; no response body"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/interviews": {
      "get": {
        "tags": [
          "Interviews"
        ],
        "summary": "List interviews",
        "description": "Returns interviews ordered by scheduled time. No query parameters are accepted. Only the signed-in user’s records are visible and editable.",
        "responses": {
          "200": {
            "description": "Interviews",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Interview"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "post": {
        "tags": [
          "Interviews"
        ],
        "summary": "Create an interview",
        "description": "applicationId must refer to an existing application. Only the signed-in user’s records are visible and editable.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InterviewInput"
              },
              "example": {
                "applicationId": "507f1f77bcf86cd799439011",
                "scheduledAt": "2026-10-02T15:00:00Z",
                "type": "video",
                "status": "scheduled",
                "interviewer": "Hiring manager",
                "location": "https://example.com/meeting",
                "notes": "Prepare portfolio examples"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created; Location header points to the resource",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Interview"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/InvalidReference"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/api/interviews/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/Id"
        }
      ],
      "get": {
        "tags": [
          "Interviews"
        ],
        "summary": "Get one interview",
        "responses": {
          "200": {
            "description": "Interview",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Interview"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "description": "Only the signed-in user’s records are visible and editable."
      },
      "put": {
        "tags": [
          "Interviews"
        ],
        "summary": "Replace an interview",
        "description": "Send all required fields. Omitted optional fields are removed. applicationId must refer to an existing application. Only the signed-in user’s records are visible and editable.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InterviewInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated interview",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Interview"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "422": {
            "$ref": "#/components/responses/InvalidReference"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "delete": {
        "tags": [
          "Interviews"
        ],
        "summary": "Delete an interview",
        "responses": {
          "204": {
            "description": "Deleted; no response body"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        },
        "description": "Only the signed-in user’s records are visible and editable."
      }
    },
    "/auth/github": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Start GitHub login or account creation",
        "description": "Open this URL in a browser. GitHub asks the user to authorize the app. The first successful login creates a user document. Do not use Swagger Execute for this browser redirect.",
        "security": [],
        "responses": {
          "302": {
            "description": "Redirect to GitHub"
          },
          "503": {
            "description": "OAuth configuration is missing"
          }
        }
      }
    },
    "/auth/github/callback": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "GitHub OAuth callback",
        "description": "GitHub redirects here with a code and state. The API exchanges the code, creates or updates the user, sets an HttpOnly session cookie, and redirects to Swagger UI.",
        "security": [],
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Signed in; redirect to API documentation"
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "502": {
            "description": "GitHub login failed"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "View the signed-in user",
        "responses": {
          "200": {
            "description": "Current user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Log out",
        "description": "Invalidates the signed-in account sessions and clears the browser cookie.",
        "responses": {
          "204": {
            "description": "Logged out; no response body"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "24-character MongoDB ObjectId",
        "schema": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{24}$",
          "example": "507f1f77bcf86cd799439011"
        }
      }
    },
    "responses": {
      "ValidationError": {
        "description": "Invalid ID, query, JSON, or body",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Validation failed",
              "details": [
                {
                  "field": "company",
                  "message": "Too small: expected string to have >=1 characters"
                }
              ]
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource does not exist",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Application not found"
            }
          }
        }
      },
      "Conflict": {
        "description": "Related interviews must be deleted first",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Delete the application's interviews first"
            }
          }
        }
      },
      "InvalidReference": {
        "description": "The applicationId does not identify an existing application",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "applicationId does not identify an existing application"
            }
          }
        }
      },
      "ServerError": {
        "description": "Unexpected server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Sign in with GitHub first",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Sign in with GitHub first"
            }
          }
        }
      }
    },
    "schemas": {
      "ApplicationInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "company",
          "position",
          "location",
          "workMode",
          "employmentType",
          "status",
          "appliedAt",
          "source"
        ],
        "properties": {
          "company": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "position": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "workMode": {
            "type": "string",
            "enum": [
              "remote",
              "hybrid",
              "onsite"
            ]
          },
          "employmentType": {
            "type": "string",
            "enum": [
              "full-time",
              "part-time",
              "contract",
              "internship"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "saved",
              "applied",
              "interviewing",
              "offer",
              "rejected",
              "withdrawn"
            ]
          },
          "appliedAt": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "jobUrl": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "salaryMin": {
            "type": "number",
            "minimum": 0
          },
          "salaryMax": {
            "type": "number",
            "minimum": 0,
            "description": "Must be at least salaryMin when both are provided"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Za-z]{3}$"
          },
          "notes": {
            "type": "string",
            "maxLength": 2000
          }
        }
      },
      "Application": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "company",
          "position",
          "location",
          "workMode",
          "employmentType",
          "status",
          "appliedAt",
          "source",
          "_id",
          "createdAt",
          "updatedAt",
          "ownerId"
        ],
        "properties": {
          "company": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "position": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "workMode": {
            "type": "string",
            "enum": [
              "remote",
              "hybrid",
              "onsite"
            ]
          },
          "employmentType": {
            "type": "string",
            "enum": [
              "full-time",
              "part-time",
              "contract",
              "internship"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "saved",
              "applied",
              "interviewing",
              "offer",
              "rejected",
              "withdrawn"
            ]
          },
          "appliedAt": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "jobUrl": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "salaryMin": {
            "type": "number",
            "minimum": 0
          },
          "salaryMax": {
            "type": "number",
            "minimum": 0,
            "description": "Must be at least salaryMin when both are provided"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Za-z]{3}$"
          },
          "notes": {
            "type": "string",
            "maxLength": 2000
          },
          "_id": {
            "type": "string",
            "example": "507f1f77bcf86cd799439011"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "ownerId": {
            "type": "string",
            "description": "MongoDB ID of the signed-in owner",
            "example": "507f1f77bcf86cd799439011"
          }
        }
      },
      "InterviewInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "applicationId",
          "scheduledAt",
          "type",
          "status"
        ],
        "properties": {
          "applicationId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{24}$"
          },
          "scheduledAt": {
            "type": "string",
            "format": "date-time"
          },
          "type": {
            "type": "string",
            "enum": [
              "phone",
              "video",
              "onsite",
              "other"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "scheduled",
              "completed",
              "cancelled"
            ]
          },
          "interviewer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "notes": {
            "type": "string",
            "maxLength": 2000
          }
        }
      },
      "Interview": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "applicationId",
          "scheduledAt",
          "type",
          "status",
          "_id",
          "createdAt",
          "updatedAt",
          "ownerId"
        ],
        "properties": {
          "applicationId": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{24}$"
          },
          "scheduledAt": {
            "type": "string",
            "format": "date-time"
          },
          "type": {
            "type": "string",
            "enum": [
              "phone",
              "video",
              "onsite",
              "other"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "scheduled",
              "completed",
              "cancelled"
            ]
          },
          "interviewer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "notes": {
            "type": "string",
            "maxLength": 2000
          },
          "_id": {
            "type": "string",
            "example": "507f1f77bcf86cd799439011"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "ownerId": {
            "type": "string",
            "description": "MongoDB ID of the signed-in owner",
            "example": "507f1f77bcf86cd799439011"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "login",
          "displayName",
          "avatarUrl"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "507f1f77bcf86cd799439011"
          },
          "login": {
            "type": "string",
            "example": "octocat"
          },
          "displayName": {
            "type": "string",
            "example": "The Octocat"
          },
          "avatarUrl": {
            "type": "string",
            "description": "GitHub avatar URL, or an empty string if unavailable"
          }
        }
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
